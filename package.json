{
  "name": "job-search-loop",
  "version": "1.3.0",
  "private": true,
  "description": "Local-first job-search planning and learning loop",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "npm run build:electron && concurrently -k \"tsc -p tsconfig.electron.json --watch\" \"vite build --config vite.preload.config.ts --watch\"",
    "dev:app": "wait-on tcp:5173 dist-electron/main/index.js && electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\" \"npm:dev:app\"",
    "build:electron": "tsc -p tsconfig.electron.json && vite build --config vite.preload.config.ts && node scripts/copy-ocr-assets.mjs",
    "build": "npm run build:electron && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build-output": "npm run build && vitest run --config vitest.build-output.config.ts",
    "test:e2e": "npm run build && playwright test",
    "smoke:win": "node scripts/smoke-win.mjs",
    "verify:ocr-assets": "node scripts/verify-ocr-assets.mjs",
    "smoke:ocr": "npm run build:electron && npm run verify:ocr-assets && node scripts/smoke-ocr.mjs",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "mammoth": "1.12.0",
    "pdfjs-dist": "6.1.200",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0",
    "tesseract.js": "7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "local.jobsearch.loop",
    "productName": "求职闭环",
    "artifactName": "JobSearchLoop-Setup-${version}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/tesseract.js-core/**/*",
      "node_modules/tesseract.js/src/worker-script/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/ocr/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "dist-electron/ocr",
        "to": "ocr"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
